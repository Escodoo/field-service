<odoo>

    <record model="ir.ui.view" id="fsm_stage_form_view">
        <field name="name">fsm.stage.form (in fieldservice_rating)</field>
        <field name="model">fsm.stage</field>
        <field name="inherit_id" ref="fieldservice.fsm_stage_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="rating_mail_template_id" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="fsm_stage_tree_view">
        <field name="name">fsm.stage.tree (in fieldservice_rating)</field>
        <field name="model">fsm.stage</field>
        <field name="inherit_id" ref="fieldservice.fsm_stage_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='custom_color']" position="after">
                <field name="rating_mail_template_id" />
            </xpath>
        </field>
    </record>

</odoo>
