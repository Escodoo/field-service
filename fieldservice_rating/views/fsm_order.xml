    <record model="ir.ui.view" id="fsm_order_kanban_view">
        <field name="name">fsm.order.kanban (in fieldservice_rating)</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_kanban_bottom_left')]" position="inside">
                <field name="positive_rate_percentage" invisible="1" />
                <b>
                    <t t-if="record.positive_rate_percentage.value != -1">
                        <a name="action_view_fsm_order_rating" type="object">
                            <i class="fa fa-smile-o" /> <t
                                t-esc="record.positive_rate_percentage.value"
                            />%
                        </a>
                    </t>
                </b>
            </xpath>
            <xpath expr="//div[hasclass('dropdown-menu')]/ul[1]" position="after">
                <li>
                    <a
                        name="action_view_fsm_order_rating"
                        type="object"
                    >Customer Rating</a>
                </li>
            </xpath>
        </field>
    </record>



</odoo>

