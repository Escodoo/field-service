<odoo>

    <record model="ir.ui.view" id="fsm_order_form_view">
        <field name="name">fsm.order.form (in fieldservice_rating)</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="positive_rate_percentage" invisible="1" />
            </xpath>
            <div name="button_box" position="inside">
                <button
                    name="action_view_fsm_order_rating"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-smile-o"
                    attrs="{'invisible': [('positive_rate_percentage', '=', -1)]}"
                >
                    <field name="rating_count" widget="statinfo" string="Ratings" />
                </button>
            </div>
            <xpath expr="//group/group[2]" position="after">
                <group>
                    <field name="rating_status" widget="radio" />
                </group>
            </xpath>

        </field>
    </record>

