<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <record id="survey.survey_user_input_rule_survey_manager" model="ir.rule">
            <field name="name">Survey user input: manager: all non private</field>
            <field
                name="domain_force"
            >[('survey_id.is_fsm_order_appraisal', '=', False)]</field>
        </record>
        <record id="survey.survey_user_input_rule_survey_user_read" model="ir.rule">
            <field name="name">Survey user input: officer: read all non private</field>
            <field
                name="domain_force"
            >[('survey_id.is_fsm_order_appraisal', '=', False)]</field>
        </record>
        <record id="survey.survey_user_input_rule_survey_user_cw" model="ir.rule">
            <field
                name="name"
            >Survey user input: officer: create/write/unlink linked to own non private survey only</field>
            <field
                name="domain_force"
            >['&amp;', ('survey_id.is_fsm_order_appraisal', '=', False), ('survey_id.create_uid', '=', user.id)]</field>
        </record>

        <record id="survey.survey_user_input_line_rule_survey_manager" model="ir.rule">
            <field name="name">Survey user input line: manager: all non private</field>
            <field
                name="domain_force"
            >[('survey_id.is_fsm_order_appraisal', '=', False)]</field>
        </record>
        <record
            id="survey.survey_user_input_line_rule_survey_user_read"
            model="ir.rule"
        >
            <field
                name="name"
            >Survey user input line: officer: read all non private</field>
            <field
                name="domain_force"
            >[('survey_id.is_fsm_order_appraisal', '=', False)]</field>
        </record>
        <record id="survey.survey_user_input_line_rule_survey_user_cw" model="ir.rule">
            <field
                name="name"
            >Survey user input line: officer: create/write/unlink linked to own non private survey only</field>
            <field
                name="domain_force"
            >['&amp;', ('survey_id.is_fsm_order_appraisal', '=', False), ('user_input_id.survey_id.create_uid', '=', user.id)]</field>
        </record>

        <record id="survey_user_input_rule_fsm_appraisal_manager" model="ir.rule">
            <field name="name">Survey user input: appraisal manager: all</field>
            <field name="model_id" ref="survey.model_survey_user_input" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field
                name="groups"
                eval="[(4, ref('fieldservice_survey.group_fsm_appraisal_manager'))]"
            />
            <field name="perm_unlink" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_read" eval="1" />
            <field name="perm_create" eval="1" />
        </record>
        <record id="survey_user_input_line_rule_fsm_appraisal_manager" model="ir.rule">
            <field name="name">Survey user input line: appraisal manager: all</field>
            <field name="model_id" ref="survey.model_survey_user_input_line" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field
                name="groups"
                eval="[(4, ref('fieldservice_survey.group_fsm_appraisal_manager'))]"
            />
            <field name="perm_unlink" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_read" eval="1" />
            <field name="perm_create" eval="1" />
        </record>
    </data>
</odoo>
