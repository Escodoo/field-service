#. module: fieldservice_survey
#: model:mail.template,report_name:fieldservice_survey.mail_template_fsm_order_survey_submit
msgid "${(object.name or '').replace('/','_')}"
msgstr "${(object.name or '').replace('/','_')}"

#. module: fieldservice_survey
#: model:mail.template,body_html:fieldservice_survey.mail_template_fsm_order_survey_submit
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Dear ${object.partner_id.name},\n"
"                        <br/><br/>\n"
"                        An survey was requested.\n"
"                        <br/>\n"
"                        Please take time to fill the survey.\n"
"                        <br/><br/>\n"
"                        Thank you!\n"
"                        <br/><br/>\n"
"                        % if ctx.get('recipient_users'):\n"
"                        <p style=\"margin: 16px 0px 16px 0px;\">\n"
"                            <a href=\"${ctx['url']}\" style=\"background-"
"color:#875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: "
"#fff; border-radius: 5px;\">\n"
"                                View Survey\n"
"                            </a>\n"
"                        </p>\n"
"                        % endif\n"
"                        <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                            <a href=\"__URL__\" style=\"background-color: "
"#875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; "
"border-radius: 5px; font-size:13px;\">\n"
"                                % if object.survey_id.certification:\n"
"                                    Start Certification\n"
"                                % else:\n"
"                                    Start Survey\n"
"                                % endif\n"
"                            </a>\n"
"                        </div>\n"
"                        % if object.deadline:\n"
"                            Please answer the survey before "
"${format_date(object.deadline)}.<br/><br/>\n"
"                        % endif\n"
"                        <br/><br/>\n"
"                        <tr><td style=\"padding:15px 20px 10px 20px;"
"\">${(object.signature or '')| safe}</td></tr>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Prezado ${object.partner_id.name},\n"
"                       <br/><br/>\n"
"                        Foi solicitada uma pesquisa.\n"
"                       <br/>\n"
"                        Por favor, reserve um tempo para preencher a "
"pesquisa.\n"
"                       <br/><br/>\n"
"                        Obrigado a você!\n"
"                       <br/><br/>\n"
"                        % if ctx.get('recipient_users'):\n"
"                        <p style=\"margin: 16px 0px 16px 0px;\">\n"
"                            <a href=\"${ctx['url']}\" style=\"background-"
"color:#875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: "
"#fff; border-radius: 5px;\">\n"
"                                Visualizar pesquisa\n"
"                            </a>\n"
"                        </p>\n"
"                       % endif\n"
"                        <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                            <a href=\"__URL__\" style=\"background-color: "
"#875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; "
"border-radius: 5px; font-size:13px;\">\n"
"                               % if object.survey_id.certification:\n"
"                                    Iniciar certificação\n"
"                               % else:\n"
"                                    Iniciar pesquisa\n"
"                               % endif\n"
"                            </a>\n"
"                        </div>\n"
"                       % if object.deadline:\n"
"                            Por favor, responda à pesquisa antes de "
"${format_date(object.deadline)}.<br/><br/>\n"
"                        % endif\n"
"                       <br/><br/>\n"
"                        <tr><td style=\"padding:15px 20px 10px 20px;"
"\">${(object.signature or '')| safe}</td></tr>\n"
"                    </p>\n"
"                </div>\n"
"            "

