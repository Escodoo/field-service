<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="all_fsm_order_rating_action" model="ir.actions.act_window">
        <field name="name">Customer Rating</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">kanban,tree,pivot,graph,form</field>
        <field
            name="domain"
        >[('res_model', '=', 'fsm.order'), ('consumed', '=', True)]</field>
        <field name="help" type="html">
            <p>
                There are no rated fsm orders at this moment.
            </p>
        </field>
    </record>
    <record id="fsm_order_rating_action" model="ir.actions.act_window">
        <field name="name" />
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">kanban,tree,pivot,graph,form</field>
        <field
            name="domain"
        >[('consumed','=',True), ('res_model','=','fsm.order'), ('res_id', '=', active_id)]</field>
        <field name="help" type="html">
            <p>
                There are no ratings for this fsm order at the moment.
            </p>
        </field>
    </record>
    <menuitem
        id="fsm_order_rating_menu"
        name="Customer Rating"
        parent="fieldservice.reporting"
        action="all_fsm_order_rating_action"
        sequence="50"
    />
</odoo>
