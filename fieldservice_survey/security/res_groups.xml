<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="group_fsm_appraisal_user" model="res.groups">
            <field name="name">FSM Survey User</field>
            <field name="category_id" ref="fieldservice.fsm" />
             <field
                name="implied_ids"
                eval="[(4, ref('fieldservice.group_fsm_user'))]"
            />
        </record>

        <record id="group_fsm_appraisal_manager" model="res.groups">
            <field name="name">FSM Survey Administrator</field>
            <field name="category_id" ref="fieldservice.fsm" />
            <field
                name="implied_ids"
                eval="[(4, ref('group_fsm_appraisal_user')), (4, ref('survey.group_survey_manager'))]"
            />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>

        <record id="fieldservice_survey.group_fsm_appraisal_manager" model="res.groups">
            <field
                name="implied_ids"
                eval="[(4, ref('survey.group_survey_manager'))]"
            />
        </record>
    </data>
</odoo>
