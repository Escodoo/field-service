<odoo>

    <record model="ir.ui.view" id="fsm_order_form_view">
        <field name="name">fsm.order.form (in fieldservice_survey)</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page
                    string="Appraisal"
                    name="appraisal_page"
                    attrs="{'invisible': [('partner_feedback_ids', '=', [])]}"
                >
                    <group>
                        <group string="Partners Appraisal" name="partners_appraisal">
                             <field
                                name="partner_feedback_ids"
                                widget="many2many_tags"
                                readonly="1"
                            />
                        </group>
                    </group>
                </page>
            </notebook>
             <xpath expr="//button[@name='action_complete']" position="after">
                <button
                    name="action_ask_feedback"
                    string="Ask Feedback"
                    type="object"
                />
            </xpath>
<!--            attrs="{-->
<!--                    'invisible': &quot;['|', ('person_id', '=', uid), ('state', 'not in', ['new', 'pending'])]&quot;}" -->


            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    name="action_open_survey_inputs"
                    icon="fa-pencil-square-o"
                    attrs="{'invisible': [('partner_feedback_ids', '=', [])]}"
                    type="object"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Feedback</span>
                        <span class="o_stat_text">Survey</span>
                    </div>
                </button>
            </xpath>


        </field>
    </record>

